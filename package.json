{
  "name": "amia-blog",
  "version": "26.10.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm content:build && concurrently -k \"pnpm content:dev\" \"next dev\"",
    "build": "pnpm content:build && next build",
    "content:build": "velite build --clean --strict",
    "content:dev": "velite dev --strict",
    "new:post": "node scripts/new-post.mjs",
    "test": "node --test",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:styles": "stylelint \"**/*.css\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.45.1",
    "botid": "^1.5.11",
    "daisyui": "^5.7.50",
    "gray-matter": "^4.0.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "velite": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "lint-staged": {
    "*.css": [
      "stylelint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "!(*.{css,ts,tsx,mjs})": [
      "prettier --write --ignore-unknown"
    ]
  }
}
